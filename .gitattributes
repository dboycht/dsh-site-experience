# Normalize line endings in the repository, whatever the contributor's platform.
# Without this, a Windows checkout rewrites every text file to CRLF and the diff
# noise buries the actual change.
* text=auto eol=lf

# These are consumed as plain text on every platform — keep them LF explicitly.
*.js   text eol=lf
*.mjs  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
